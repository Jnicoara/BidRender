diff --git a/client/src/lib/markKeys.ts b/client/src/lib/markKeys.ts
index cd432bd7..85607f96 100644
--- a/client/src/lib/markKeys.ts
+++ b/client/src/lib/markKeys.ts
@@ -1,11 +1,13 @@
 /**
- * The key a queued mark is sent with (server/markReplay.ts places each key
- * ONCE per bid, so a batch resent after a lost answer counts once).
+ * The key a queued mark is sent with (the server places each key ONCE per
+ * bid — `takeoff_stamps.clientKey`, unique per bid since 0168 — so a batch
+ * resent after a lost answer counts once).
  *
  * ── Why not the queue's own key ───────────────────────────────────────────
  * The Plans screen's queue numbers its marks -1, -2, … and the counter starts
- * again on every page load and in every tab. The server remembers a key per
- * BID for a day. Sent bare, the first mark after a reload — or the first mark
+ * again on every page load and in every tab. The server keeps a key per BID
+ * for as long as its mark exists (a day, in memory, before 0168). Sent bare,
+ * the first mark after a reload — or the first mark
  * in a second tab — would arrive as "-1", be taken for a resend, and never be
  * placed: a mark that vanishes, found before it shipped (Track B, 2026-10-16,
  * reading Track A's handoff). So every key carries this page load's own
diff --git a/client/src/pages/TakeoffPage.tsx b/client/src/pages/TakeoffPage.tsx
index 5d863fc5..152edf42 100644
--- a/client/src/pages/TakeoffPage.tsx
+++ b/client/src/pages/TakeoffPage.tsx
@@ -7188,7 +7188,7 @@ export default function TakeoffPage({
           at: batch.map(m => ({ x: m.x, y: m.y })),
           // One per click: a batch resent after a LOST answer (the server
           // wrote it, the reply never came) places each mark once, not
-          // twice (server/markReplay.ts; Track A's counting deep test).
+          // twice (`takeoff_stamps.clientKey`, 0168; markReplay.test.ts).
           // Never the bare queue number, which restarts every page load:
           // see @/lib/markKeys.
           keys: batch.map(m => markKey(MARK_SESSION, m.key)),
