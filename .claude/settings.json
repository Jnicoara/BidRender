{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-git-stash.mjs",
            "timeout": 10,
            "statusMessage": "Checking for git stash"
          }
        ]
      }
    ]
  }
}
